Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PYTHONUNBUFFERED=1
    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
    # Disable numba caching to avoid read-only filesystem issues
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    export NUMBA_DISABLE_CACHE=1
    # Note: PyTorch is provided by Mahti module system at runtime
    # The container does not include PyTorch to save space

%post
    # Update and install system packages
    apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3-pip \
        python3-dev \
        git \
        wget \
        build-essential \
        bc \
        && rm -rf /var/lib/apt/lists/*

    # Create symlink for python (force overwrite if exists)
    ln -sf /usr/bin/python3.10 /usr/bin/python
    ln -sf /usr/bin/python3.10 /usr/bin/python3

    # Upgrade pip
    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # NOTE: PyTorch is NOT installed in the container
    # It will be provided by the Mahti pytorch/2.0 module at runtime
    # This saves ~2-3 GB of container size and avoids build space issues

    # Install scientific computing packages
    python3 -m pip install --no-cache-dir \
        numpy>=1.21.0 \
        scipy \
        pandas \
        matplotlib \
        seaborn \
        scikit-learn \
        scikit-image

    # Install astronomy packages
    python3 -m pip install --no-cache-dir \
        astropy \
        photutils \
        lenstronomy \
        shapely

    # Install light curve packages
    python3 -m pip install --no-cache-dir \
        celerite2 \
        sncosmo

    # Install image processing
    python3 -m pip install --no-cache-dir \
        pillow \
        opencv-python

    # Install ML utilities
    python3 -m pip install --no-cache-dir \
        joblib

    # Install other dependencies
    python3 -m pip install --no-cache-dir \
        pyyaml \
        tqdm

    # Create working and cache directories
    mkdir -p /workspace
    mkdir -p /tmp/numba_cache

%runscript
    exec "$@"

%labels
    Author JWST Lens Simulator
    Version 1.0
    Description Container for JWST lens simulation and ML training
